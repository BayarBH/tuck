{
  "name": "tuck",
  "productName": "Tuck",
  "version": "0.1.0",
  "description": "Copy to capture: double-tap or hold Ctrl+C to save text into a Markdown notes file",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "lint": "node scripts/lint.js",
    "icons": "electron scripts/make-icons.js",
    "dist": "node scripts/dist.js",
    "release": "node scripts/dist.js --publish"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bayar.tuck",
    "productName": "Tuck",
    "files": [
      "src/**",
      "config.js",
      "package.json",
      "build/icon.*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tuck",
      "artifactName": "Tuck-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BayarBH",
        "repo": "tuck",
        "releaseType": "draft"
      }
    ],
    "npmRebuild": false
  }
}
