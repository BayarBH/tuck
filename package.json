{
  "name": "tuck",
  "productName": "Tuck",
  "version": "0.1.0",
  "description": "Copy to capture: double-tap or hold Ctrl+C to save text into a Markdown notes file",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "lint": "node scripts/lint.js",
    "icons": "electron scripts/make-icons.js",
    "dist": "node scripts/dist.js",
    "release": "node scripts/dist.js --publish",
    "dist:mac": "node scripts/dist.js --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bayar.tuck",
    "productName": "Tuck",
    "files": [
      "src/**",
      "config.js",
      "package.json",
      "build/icon.*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tuck",
      "artifactName": "Tuck-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Tuck-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Tuck reads the front window's title to skip private windows and returns focus after you add a thought."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "afterPack": "scripts/mac-adhoc-sign.js",
    "publish": [
      {
        "provider": "github",
        "owner": "BayarBH",
        "repo": "tuck",
        "releaseType": "draft"
      }
    ],
    "npmRebuild": false
  }
}
